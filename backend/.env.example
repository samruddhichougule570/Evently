# Copy this file to ".env" and fill in your own values. NEVER commit the real .env file.
PORT=5000
MONGO_URI=mongodb://localhost:27017/eventdb
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:5173

# --- Razorpay (optional) ---
# Get TEST keys free from https://dashboard.razorpay.com -> Settings -> API Keys (switch to "Test Mode" first).
# If these two are left empty, the app automatically uses the built-in demo payment gateway instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Seed script (optional) ---
# Passwords for the demo accounts created by `npm run seed`. Defaults to password123 if not set.
SEED_PASSWORD=
